{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-workspace.local/schemas/inquiry.schema.json",
  "title": "Inquiry Protocol",
  "description": "Reusable protocol for request intake, exploration planning, and inquiry convergence.",
  "$ref": "#/definitions/RequestIntakeResult",
  "definitions": {
    "RequestIntakeResult": {
      "type": "object",
      "required": [
        "schema_version",
        "phase",
        "understanding",
        "candidate_scopes",
        "scope_assessment",
        "exploration_plan",
        "open_questions",
        "assumptions",
        "decisions",
        "next_action"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "request-intake/v1"
        },
        "phase": {
          "type": "string",
          "enum": [
            "plan_exploration",
            "assess_scope_after_exploration"
          ]
        },
        "understanding": {
          "type": "string",
          "minLength": 1
        },
        "candidate_scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/CandidateScope"
          }
        },
        "scope_assessment": {
          "$ref": "#/definitions/ScopeAssessment"
        },
        "exploration_plan": {
          "$ref": "#/definitions/ExplorationPlan"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpenQuestion"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_action": {
          "type": "string",
          "enum": [
            "run_exploration",
            "scope_checkpoint",
            "continue_inquiry",
            "blocked"
          ]
        },
        "blocked_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "InquiryStepResult": {
      "type": "object",
      "required": [
        "schema_version",
        "action",
        "open_questions",
        "assumptions",
        "decisions"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "inquiry-step/v1"
        },
        "action": {
          "type": "string",
          "enum": [
            "ask_question",
            "run_exploration",
            "converged",
            "blocked"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "exploration_requests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExplorationRequest"
          }
        },
        "scope_assessment": {
          "$ref": "#/definitions/ScopeAssessment"
        },
        "understanding_update": {
          "type": "string",
          "minLength": 1
        },
        "open_questions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpenQuestion"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "CandidateScope": {
      "type": "object",
      "required": [
        "ref",
        "title",
        "project",
        "summary",
        "independence",
        "reason",
        "requirements",
        "likely_surfaces"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^SC-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "$ref": "#/definitions/ProjectRef"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "independence": {
          "type": "string",
          "enum": [
            "single",
            "likely_independent",
            "uncertain"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "likely_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "ScopeAssessment": {
      "type": "object",
      "required": [
        "readiness",
        "needs_split",
        "reason",
        "confidence",
        "independent_scope_count",
        "suggested_sub_topics",
        "recommended_action"
      ],
      "properties": {
        "readiness": {
          "type": "string",
          "enum": [
            "preliminary",
            "after_exploration"
          ]
        },
        "needs_split": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "independent_scope_count": {
          "type": "number",
          "minimum": 1
        },
        "suggested_sub_topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_action": {
          "type": "string",
          "enum": [
            "run_exploration",
            "ask_scope_question",
            "scope_checkpoint",
            "continue_as_single_scope",
            "blocked"
          ]
        }
      },
      "additionalProperties": false
    },
    "ExplorationPlan": {
      "type": "object",
      "required": [
        "strategy",
        "coverage",
        "requests"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "object",
          "required": [
            "doc_baseline",
            "code_baseline",
            "history_baseline",
            "surface_probe",
            "external_research"
          ],
          "properties": {
            "doc_baseline": {
              "type": "boolean"
            },
            "code_baseline": {
              "type": "boolean"
            },
            "history_baseline": {
              "type": "boolean"
            },
            "surface_probe": {
              "type": "boolean"
            },
            "external_research": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExplorationRequest"
          }
        }
      },
      "additionalProperties": false
    },
    "ExplorationRequest": {
      "type": "object",
      "required": [
        "ref",
        "task",
        "scope_ref",
        "focus",
        "reason",
        "expected_evidence",
        "priority"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^EXP-[0-9]{3,}$"
        },
        "task": {
          "type": "string",
          "enum": [
            "explore_code",
            "explore_commit",
            "librarian"
          ]
        },
        "scope_ref": {
          "type": "string",
          "pattern": "^SC-[0-9]{3,}$"
        },
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expected_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "baseline",
            "surface",
            "history",
            "external",
            "follow_up"
          ]
        }
      },
      "additionalProperties": false
    },
    "OpenQuestion": {
      "type": "object",
      "required": [
        "ref",
        "question",
        "blocking",
        "owner",
        "resolution_hint"
      ],
      "properties": {
        "ref": {
          "$ref": "#/definitions/QuestionRef"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "enum": [
            "user",
            "exploration",
            "orchestrator"
          ]
        },
        "resolution_hint": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "QuestionRef": {
      "type": "string",
      "pattern": "^Q-[0-9]{3,}$"
    },
    "ProjectRef": {
      "$ref": "https://agent-workspace.local/schemas/shared.schema.json#/definitions/ProjectRef"
    }
  }
}
