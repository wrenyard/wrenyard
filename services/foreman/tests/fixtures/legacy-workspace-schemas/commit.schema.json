{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-workspace.local/schemas/commit.schema.json",
  "title": "Commit Protocol",
  "description": "Shared commit request and report protocol for local git commit tasks and implementation workflows.",
  "$ref": "#/definitions/CommitRequest",
  "definitions": {
    "CommitChangeSet": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "description": "What to stage from this file. Use \"all\" to stage the whole file, or describe the specific hunk/intent to stage while leaving other changes unstaged."
      },
      "description": "Map of relative file path to staging scope."
    },
    "CommitRequest": {
      "type": "object",
      "required": [
        "changes_to_commit"
      ],
      "properties": {
        "changes_to_commit": {
          "$ref": "#/definitions/CommitChangeSet"
        },
        "need_push": {
          "type": "boolean",
          "default": false,
          "description": "If true, push the current branch to origin after commit. Default: false."
        },
        "atomic_commit": {
          "type": "boolean",
          "default": true,
          "description": "If true, split declared changes into atomic commits. If false, commit all declared changes together. Default: true."
        }
      },
      "additionalProperties": false
    },
    "CommitNumstatRow": {
      "type": "object",
      "required": [
        "file",
        "added",
        "deleted",
        "raw"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "added": {
          "type": "integer",
          "minimum": 0,
          "description": "Numeric additions from git numstat; use 0 for binary \"-\" rows."
        },
        "deleted": {
          "type": "integer",
          "minimum": 0,
          "description": "Numeric deletions from git numstat; use 0 for binary \"-\" rows."
        },
        "raw": {
          "type": "string",
          "description": "Original tab-separated git numstat row."
        }
      },
      "additionalProperties": false
    },
    "CommitStats": {
      "type": "object",
      "required": [
        "files_changed",
        "added_lines",
        "deleted_lines",
        "edited_lines",
        "raw_shortstat",
        "raw_numstat"
      ],
      "properties": {
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "added_lines": {
          "type": "integer",
          "minimum": 0
        },
        "deleted_lines": {
          "type": "integer",
          "minimum": 0
        },
        "edited_lines": {
          "type": "integer",
          "minimum": 0,
          "description": "Lower-bound line edits, calculated as sum(min(added, deleted)) from numeric numstat rows."
        },
        "raw_shortstat": {
          "type": "string",
          "description": "Raw output from git show --shortstat --format= <hash>."
        },
        "raw_numstat": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CommitNumstatRow"
          }
        }
      },
      "additionalProperties": false
    },
    "CommitInfo": {
      "type": "object",
      "required": [
        "hash",
        "message",
        "stats"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "stats": {
          "$ref": "#/definitions/CommitStats"
        }
      },
      "additionalProperties": false
    },
    "CommitReport": {
      "type": "object",
      "required": [
        "commits",
        "pushed"
      ],
      "properties": {
        "commits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/CommitInfo"
          }
        },
        "pushed": {
          "type": "boolean",
          "description": "True only if need_push was true and git push succeeded."
        }
      },
      "additionalProperties": false
    }
  }
}
