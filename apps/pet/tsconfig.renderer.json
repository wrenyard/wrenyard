{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist/renderer",
    "rootDir": "."
  },
  "include": [
    "src/shared/**/*",
    "src/render/**/*",
    "src/features/**/*",
    "src/overlay/**/*",
    "src/panels/**/*",
    "scripts/preview/**/*.ts",
    "scripts/preview/**/*.d.ts"
  ]
}
