{
  "workspace": {
    "root": "/path/to/wrenyard-suite"
  },
  "tasks": {
    "agentRuntime": {}
  },
  "message": {
    "enabled": true,
    "principals": {
      "codex": {
        "kind": "agent",
        "can_send": true,
        "can_receive": false,
        "grants": [{ "name": "message.send" }]
      },
      "operator": {
        "kind": "human",
        "can_send": true,
        "can_receive": true,
        "delivery_route": "operator.telegram",
        "grants": [{ "name": "message.send" }]
      }
    },
    "routes": {
      "operator.telegram": {
        "transport": "telegram",
        "address": {
          "chat_id": "telegram-chat-id",
          "token_env": "WRENYARD_TELEGRAM_BOT_TOKEN"
        },
        "format": "telegram-html"
      }
    },
    "delivery": {
      "enabled": true,
      "default": ["local.system"],
      "methods": {
        "local.system": {
          "backend": "system"
        }
      }
    }
  }
}
