{
  "name": "@wrenyard/desktop",
  "version": "1.0.0-dev.35",
  "private": true,
  "description": "Wrenyard Desktop product shell for daemon features and its in-process Pet companion.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node tools/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "node tools/pet/renderer-cleanup-scan.mjs && node --test tools/convert-settings.test.mjs && tsx --test test/*.test.ts && vitest run",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "icon": "node tools/render-app-icon.mjs",
    "pet:preview:capture": "electron --force-device-scale-factor=1 --force-color-profile=srgb tools/pet/scripts/preview-capture.mjs",
    "pet:taskgraph:capture": "electron --force-device-scale-factor=1 --force-color-profile=srgb tools/pet/scripts/taskgraph-e2e-capture.mjs",
    "convert:settings": "node tools/convert-settings.mjs",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:zip": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@wrenyard/control-client": "workspace:*",
    "@wrenyard/clients": "workspace:*",
    "@wrenyard/protocol": "workspace:*",
    "@wrenyard/models": "workspace:*",
    "@wrenyard/providers": "workspace:*",
    "js-tiktoken": "1.0.21",
    "@wrenyard/auto-routing": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "pixi.js": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
