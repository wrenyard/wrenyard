{
  "name": "@wrenyard/desktop",
  "version": "1.0.0-dev.45",
  "private": true,
  "description": "Wrenyard Desktop product shell for daemon features and its in-process Pet companion.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node tools/clean-dist.mjs && electron-vite build",
    "dev": "electron-vite dev --watch",
    "test": "node tools/pet/renderer-cleanup-scan.mjs && node --test tools/convert-settings.test.mjs && tsx --test test/*.test.ts && vitest run",
    "icon": "electron tools/render-theme-icons.mjs",
    "pet:preview:capture": "electron --force-device-scale-factor=1 --force-color-profile=srgb tools/pet/scripts/preview-capture.mjs",
    "pet:taskgraph:capture": "electron --force-device-scale-factor=1 --force-color-profile=srgb tools/pet/scripts/taskgraph-e2e-capture.mjs",
    "convert:settings": "node tools/convert-settings.mjs"
  },
  "dependencies": {
    "@wrenyard/auto-routing": "workspace:*",
    "@wrenyard/clients": "workspace:*",
    "@wrenyard/control-client": "workspace:*",
    "@wrenyard/models": "workspace:*",
    "@wrenyard/protocol": "workspace:*",
    "@wrenyard/providers": "workspace:*",
    "@wrenyard/themes": "workspace:*",
    "cmdk": "^1.1.1",
    "js-tiktoken": "1.0.21",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@wrenyard/session": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "5.0.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.48.0",
    "pixi.js": "^8.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "6.4.3",
    "vitest": "^3.2.6"
  }
}
