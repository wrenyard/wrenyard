# Dependencies, build output, and generated artifacts (root and nested).
node_modules/
dist/
build/
coverage/
.artifacts/
# Desktop installers are written to the repository-root release/ directory, and
# the publish job stages downloads in release-assets/. A leading slash anchors
# these to the repository root so tools/release/ is never matched.
/release/
/release-assets/

# The NSIS custom include is source, not build output, and must stay tracked
# despite the generic build/ rule above.
!apps/desktop/build/
!apps/desktop/build/installer.nsh

# Generated runtime payload binaries.
bin/daemon/
bin/foreman-task.*

# Local environment, logs, configuration, and state.
.env*
logs/
config.yaml
.state/
.wrenyard/

# Managed worktrees.
worktrees/

# Track the canonical Zod source-of-truth schemas (not generated/legacy dirs).
schemas/
!apps/daemon/lib/core/task/schemas/
!apps/daemon/lib/core/task/schemas/*.mts
