{
  "name": "wrenyard",
  "version": "1.0.0-dev.38",
  "description": "Wrenyard — source-development preview suite for task orchestration, runtime, and desktop visualization",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrenyard/wrenyard.git"
  },
  "homepage": "https://github.com/wrenyard/wrenyard#readme",
  "bugs": {
    "url": "https://github.com/wrenyard/wrenyard/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "bin": {
    "wrenyard": "./bin/wrenyard.mjs"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:tools": "node --test tools/*.test.mjs tools/**/*.test.mjs",
    "test:workspace": "pnpm run test:tools && pnpm -r --if-present run test",
    "test": "pnpm run test:workspace",
    "product": "node ./bin/wrenyard.mjs",
    "cli": "pnpm run product",
    "dev": "node ./tools/dev/run.mjs",
    "version:sync": "node tools/version-sync.mjs --write",
    "version:check": "node tools/version-sync.mjs --check",
    "desktop:dev": "pnpm --filter @wrenyard/desktop run dev",
    "desktop:install": "node tools/desktop/install-dev.mjs",
    "desktop:install-dev": "node tools/desktop/install-dev.mjs",
    "desktop:release": "pnpm --filter @wrenyard/desktop run dist:zip",
    "check:packages": "pnpm -r --if-present run check",
    "check:workspace": "pnpm run typecheck && pnpm run test:workspace && pnpm run check:packages && pnpm run build",
    "check:identifiers": "node tools/check-public-identifiers.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "release:legal": "node tools/release/verify-legal.mjs",
    "release:licenses": "node tools/release/generate-license-report.mjs",
    "release:sea": "node tools/release/build-sea.mjs",
    "release:local": "node tools/release/build-local-release.mjs",
    "release:validate": "node tools/release/validate-release.mjs",
    "release:stage-public": "node tools/release/stage-public-assets.mjs",
    "release:publish-github": "node tools/release/publish-github-release.mjs",
    "release:publish-feed": "node tools/release/publish-update-feed.mjs",
    "release:cleanup-artifacts": "node tools/release/cleanup-run-artifacts.mjs",
    "release:e2e": "node --test tests/install/packed-install.test.mjs",
    "release:check": "node tools/release/verify-manifest.mjs && node tools/release/verify-legal.mjs",
    "desktop:smoke": "node tools/release/smoke-desktop.mjs",
    "check": "pnpm run check:identifiers && pnpm run check:secrets && pnpm run release:check && pnpm run check:workspace"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "archiver": "^7.0.1",
    "node": "24.19.0",
    "pnpm": "11.19.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0"
  }
}
