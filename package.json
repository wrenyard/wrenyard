{
  "name": "wrenyard",
  "version": "1.0.0-dev.43",
  "description": "Wrenyard — source-development preview suite for task orchestration, runtime, and desktop visualization",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrenyard/wrenyard.git"
  },
  "homepage": "https://github.com/wrenyard/wrenyard#readme",
  "bugs": {
    "url": "https://github.com/wrenyard/wrenyard/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "bin": {
    "wrenyard": "./bin/wrenyard.mjs"
  },
  "scripts": {
    "wrenyard": "node ./bin/wrenyard.mjs",
    "build": "pnpm --filter @wrenyard/desktop run build",
    "dev:daemon": "node ./tools/dev/run.mjs --daemon-only",
    "dev:desktop": "node ./tools/dev/run.mjs",
    "release": "node ./tools/release/release.mjs",
    "lint": "oxlint && tsc -p tsconfig.json --noEmit",
    "check": "node tools/check.mjs",
    "test": "node --test tools/*.test.mjs tools/**/*.test.mjs && pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "node": "24.19.0",
    "oxlint": "^1.0.0",
    "pnpm": "11.19.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0"
  }
}
