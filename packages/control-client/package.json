{
  "name": "@wrenyard/control-client",
  "version": "1.0.0-dev.41",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport/index.ts",
    "./session": "./src/session.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:@wrenyard/control-client/transport"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@wrenyard/protocol": "workspace:*"
  }
}
