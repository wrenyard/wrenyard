    "@wrenyard/protocol": "workspace:*",
    "@wrenyard/providers": "workspace:*",
    "js-tiktoken": "1.0.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
