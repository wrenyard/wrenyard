{
  "name": "@wrenyard/provider-service",
  "version": "1.0.0-dev.37",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Provider product feature: catalog listing and configuration plus per-provider quota acquisition.",
  "exports": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js"
  },
  "dependencies": {
    "@wrenyard/providers": "workspace:*",
    "@wrenyard/protocol": "workspace:*",
    "@wrenyard/quota": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
