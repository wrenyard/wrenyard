{
  "name": "@wrenyard/exec",
  "version": "1.0.0-dev.40",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Raw prompt-execution feature: starts one resolved agent client, replays its events under explicit bounds, and exposes snapshots and cancellation.",
  "exports": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js"
  },
  "dependencies": {
    "@wrenyard/agent-client": "workspace:*",
    "@wrenyard/clients": "workspace:*",
    "@wrenyard/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
