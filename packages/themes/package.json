{
  "name": "@wrenyard/themes",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Reusable Desktop theme definitions: pure token data, ThemeDefinition metadata and per-theme CSS token files.",
