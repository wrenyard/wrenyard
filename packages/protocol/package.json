    "./activity": "./src/activity/index.ts",
    "./agent": "./src/agent/index.ts",
    "./bot": "./src/bot/index.ts",
    "./client": "./src/client/index.ts",
    "./components": "./src/components/index.ts",
    "./daemon": "./src/daemon/index.ts",
    "./event": "./src/event/index.ts",
    "./gateway": "./src/gateway/index.ts",
    "./stats": "./src/stats/index.ts",
    "./storage": "./src/storage/index.ts",
    "./exec": "./src/exec/index.ts",
    "./provider": "./src/provider/index.ts",
    "./project": "./src/project/index.ts",
    "./routine": "./src/routine/index.ts",
    "./update-feed": "./src/update-feed.ts",
    "./workspace": "./src/workspace/index.ts",
